{
  "watch": [
    "server.js",
    "routes/**/*.js",
    "controllers/**/*.js",
    "models/**/*.js",
    "middleware/**/*.js",
    "config/**/*.js",
    ".env"
  ],
  "ignore": [
    "node_modules/**",
    "logs/**",
    "*.test.js"
  ],
  "ext": "js,json",
  "delay": 2000,
  "verbose": false,
  "execMap": {
    "js": "node"
  },
  "env": {
    "NODE_ENV": "development"
  },
  "restartable": "rs",
  "colours": true,
  "legacyWatch": false,
  "events": {
    "restart": "echo Backend restarting...",
    "crash": "echo Backend crashed - waiting before restart..."
  }
}
