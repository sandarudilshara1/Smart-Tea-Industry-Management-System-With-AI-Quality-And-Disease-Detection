# Backend environment variables (example)

# Server
PORT=5000
NODE_ENV=development

# Mongo
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/tea_factory?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here

# SMTP (Email notifications)
# If these are not set, emails will be skipped (best-effort).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_or_smtp_password
SMTP_FROM=GreenLeaf <your_email@example.com>
